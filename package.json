{
  "name": "vue-markdown-suite",
  "version": "0.1.0",
  "description": "A general-purpose, customizable, plugin-driven Vue 3 Markdown component suite.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "browserslist": [
    "chrome >= 54",
    "edge >= 15",
    "firefox >= 52",
    "safari >= 10.1",
    "ios_saf >= 10.3"
  ],
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./headless": {
      "types": "./dist/headless.d.ts",
      "import": "./dist/headless.js"
    },
    "./pipeline": {
      "types": "./dist/pipeline.d.ts",
      "import": "./dist/pipeline.js"
    },
    "./plugins": {
      "types": "./dist/plugins.d.ts",
      "import": "./dist/plugins.js"
    },
    "./node-components": {
      "types": "./dist/node-components.d.ts",
      "import": "./dist/node-components.js"
    },
    "./components/*": {
      "types": "./dist/components/*.d.ts",
      "import": "./dist/components/*.js"
    },
    "./styles/tokens.css": "./dist/styles/tokens.css",
    "./styles/components.css": "./dist/styles/components.css",
    "./styles/math.css": "./dist/styles/math.css",
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite --config vite.demo.config.ts",
    "build": "npm run build:lib && npm run build:demo",
    "build:lib": "vite build --config vite.lib.config.ts && node scripts/copy-styles.mjs && node scripts/fix-dts.mjs",
    "build:demo": "vite build --config vite.demo.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "size": "node scripts/size-guard.mjs",
    "bench": "node bench/index.mjs"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "highlight.js": {
      "optional": true
    },
    "katex": {
      "optional": true
    },
    "shiki": {
      "optional": true
    },
    "mermaid": {
      "optional": true
    },
    "@codemirror/state": {
      "optional": true
    },
    "@codemirror/view": {
      "optional": true
    },
    "@codemirror/language": {
      "optional": true
    },
    "@codemirror/commands": {
      "optional": true
    }
  },
  "dependencies": {
    "github-slugger": "^2.0.0",
    "hast-util-sanitize": "^5.0.2",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vfile": "^6.0.3",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/server-renderer": "^3.5.44",
    "@vue/test-utils": "^2.5.1",
    "commonmark-spec": "^0.31.2",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^10.11.1",
    "happy-dom": "^21.0.4",
    "hast-util-from-html": "^2.0.3",
    "hast-util-to-html": "^9.0.5",
    "highlight.js": "^11.12.0",
    "katex": "^0.19.1",
    "mermaid": "^12.2.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "shiki": "^4.5.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.0.5",
    "vue": "^3.5.44",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.13"
  }
}
