{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "lib": ["ES2016", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "node"],
    "baseUrl": ".",
    "paths": {
      "@coderminer/vue-markdown": ["./src/index.ts"],
      "@coderminer/vue-markdown/headless": ["./src/headless.ts"],
      "@coderminer/vue-markdown/pipeline": ["./src/pipeline.ts"],
      "@coderminer/vue-markdown/plugins": ["./src/plugins.ts"],
      "@coderminer/vue-markdown/presets": ["./src/presets.ts"],
      "@coderminer/vue-markdown/node-components": ["./src/node-components.ts"],
      "@coderminer/vue-markdown/highlight": ["./src/highlight/index.ts"],
      "@coderminer/vue-markdown/highlight/shiki": ["./src/highlight/shiki.ts"],
      "@coderminer/vue-markdown/math": ["./src/math/index.ts"],
      "@coderminer/vue-markdown/mermaid": ["./src/mermaid/index.ts"],
      "@coderminer/vue-markdown/html": ["./src/html/index.ts"],
      "@coderminer/vue-markdown/editor": ["./src/editor/index.ts"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.vue",
    "demo/**/*.ts",
    "demo/**/*.vue",
    "docs/**/*.ts",
    "docs/**/*.vue",
    "tests/**/*.ts",
    "env.d.ts"
  ],
  "references": [{ "path": "./tsconfig.node.json" }]
}
