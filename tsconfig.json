{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "lib": ["ES2016", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "node"],
    "baseUrl": ".",
    "paths": {
      "vue-markdown-suite": ["./src/index.ts"],
      "vue-markdown-suite/headless": ["./src/headless.ts"],
      "vue-markdown-suite/pipeline": ["./src/pipeline.ts"],
      "vue-markdown-suite/plugins": ["./src/plugins.ts"],
      "vue-markdown-suite/presets": ["./src/presets.ts"],
      "vue-markdown-suite/node-components": ["./src/node-components.ts"],
      "vue-markdown-suite/highlight": ["./src/highlight/index.ts"],
      "vue-markdown-suite/highlight/shiki": ["./src/highlight/shiki.ts"],
      "vue-markdown-suite/math": ["./src/math/index.ts"],
      "vue-markdown-suite/mermaid": ["./src/mermaid/index.ts"],
      "vue-markdown-suite/editor": ["./src/editor/index.ts"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.vue",
    "demo/**/*.ts",
    "demo/**/*.vue",
    "tests/**/*.ts",
    "env.d.ts"
  ],
  "references": [{ "path": "./tsconfig.node.json" }]
}
